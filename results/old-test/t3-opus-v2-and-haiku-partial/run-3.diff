+type FeedReactions = FeedItem['reactions'];
+
+/**
+ * An in-flight reaction change on one comment. `stored` is the last reaction
+ * list the backend accepted; `latest` is what the screen shows, including
+ * clicks whose write is still queued; `tail` is the last queued write.
+ */
+type ReactionSave = { stored: FeedReactions; latest: FeedReactions; tail: Promise<void> };
+
+/** Flip the signed-in user's reaction to `emoji`. Returns a new list. */
+function toggleReaction(reactions: FeedReactions, emoji: string): NonNullable<FeedReactions> {
+  const next = [...(reactions ?? [])];
+  const idx = next.findIndex(r => r.emoji === emoji);
+  if (idx < 0) {
+    next.push({ emoji, count: 1, reacted: true });
+  } else if (!next[idx].reacted) {
+    next[idx] = { ...next[idx], count: next[idx].count + 1, reacted: true };
+  } else if (next[idx].count <= 1) {
+    next.splice(idx, 1);
+  } else {
+    next[idx] = { ...next[idx], count: next[idx].count - 1, reacted: false };
+  }
+  return next;
+}
+
+/**
+ * Serialise a comment's reactions into the `{ emoji: userIds[] }` JSON the
+ * `sys_comment.reactions` column stores.
+ */
+function reactionsToStored(reactions: NonNullable<FeedReactions>, userId: string): string {
+  const remoteShape: Record<string, string[]> = {};
+  for (const r of reactions) {
+    // We don't have the original user-id list locally, so we approximate by
+    // emitting the signed-in user when they are the (only known) reactor. This
+    // is an over-simplification for single-user pilot installs and will be
+    // replaced by a proper backend reaction endpoint in M11.
+    const ids: string[] = [];
+    if (r.reacted) ids.push(userId);
+    // Pad with a synthetic marker so count is preserved across refreshes from
+    // other clients (best-effort).
+    while (ids.length < r.count) ids.push('__other__');
+    remoteShape[r.emoji] = ids;
+  }
+  return JSON.stringify(remoteShape);
+}
