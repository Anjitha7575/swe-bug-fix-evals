+/** Flip the signed-in user's reaction to `emoji` on a reaction list (pure). */
+function toggleOwnReaction(reactions: FeedItem['reactions'], emoji: string): NonNullable<FeedItem['reactions']> {
+  const next = [...(reactions ?? [])];
+  const idx = next.findIndex(r => r.emoji === emoji);
+  if (idx < 0) return [...next, { emoji, count: 1, reacted: true }];
+  const r = next[idx];
+  if (!r.reacted) {
+    next[idx] = { ...r, count: r.count + 1, reacted: true };
+  } else if (r.count <= 1) {
+    next.splice(idx, 1);
+  } else {
+    next[idx] = { ...r, count: r.count - 1, reacted: false };
+  }
+  return next;
+}
+
+/**
+ * The `sys_comment.reactions` JSON shape (`{ emoji: userIds[] }`) for a reaction
+ * list. Only the signed-in user's own id is known locally; other reactors are
+ * padded with a synthetic marker so the count survives a refresh (best-effort
+ * until the backend reaction endpoint lands in M11).
+ */
+function toRemoteReactionShape(reactions: NonNullable<FeedItem['reactions']>, userId: string): Record<string, string[]> {
+  const remoteShape: Record<string, string[]> = {};
+  for (const r of reactions) {
+    const ids: string[] = r.reacted ? [userId] : [];
+    while (ids.length < r.count) ids.push('__other__');
+    remoteShape[r.emoji] = ids;
+  }
+  return remoteShape;
+}
