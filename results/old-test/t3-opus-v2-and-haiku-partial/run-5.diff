+type ReactionList = NonNullable<FeedItem['reactions']>;
+
+/**
+ * The reaction state of one comment while its saves are still settling.
+ * `saved` is the last shape the store accepted; the shown state is `saved`
+ * with every pending click replayed on top, so a failed save drops only its
+ * own click and the view never shows a change that was not stored.
+ */
+interface ReactionLane {
+  saved: ReactionList;
+  pending: Array<{ emoji: string }>;
+  tail: Promise<void>;
+}
+
+/** Flip one emoji for the signed-in user: add it, or remove their own. */
+function toggleReaction(reactions: ReactionList, emoji: string): ReactionList {
+  const next = [...reactions];
+  const idx = next.findIndex(r => r.emoji === emoji);
+  if (idx >= 0) {
+    const r = next[idx];
+    if (r.reacted) {
+      // Remove user's reaction
+      if (r.count <= 1) {
+        next.splice(idx, 1);
+      } else {
+        next[idx] = { ...r, count: r.count - 1, reacted: false };
+      }
+    } else {
+      next[idx] = { ...r, count: r.count + 1, reacted: true };
+    }
+  } else {
+    next.push({ emoji, count: 1, reacted: true });
+  }
+  return next;
+}
+
+/**
+ * Rebuild the canonical stored shape `{ emoji: userIds[] }` from reactions.
+ * We don't have the original user-id list locally, so we approximate by
+ * emitting the signed-in user when they are the (only known) reactor. This is
+ * an over-simplification for single-user pilot installs and will be replaced
+ * by a proper backend reaction endpoint in M11.
+ */
+function toStoredReactions(reactions: ReactionList, userId: string): Record<string, string[]> {
+  const remoteShape: Record<string, string[]> = {};
+  for (const r of reactions) {
+    const ids: string[] = [];
+    if (r.reacted) ids.push(userId);
+    // Pad with a synthetic marker so count is preserved across
+    // refreshes from other clients (best-effort).
+    while (ids.length < r.count) ids.push('__other__');
+    remoteShape[r.emoji] = ids;
+  }
+  return remoteShape;
+}
