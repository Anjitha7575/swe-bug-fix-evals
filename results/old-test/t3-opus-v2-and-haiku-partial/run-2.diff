+type Reactions = NonNullable<FeedItem['reactions']>;
+
+/** Flip the signed-in user's reaction to `emoji`; pure, so it is safe to call from any click. */
+function toggleReaction(reactions: Reactions, emoji: string): Reactions {
+  const next = [...reactions];
+  const idx = next.findIndex(r => r.emoji === emoji);
+  if (idx < 0) return [...next, { emoji, count: 1, reacted: true }];
+  const r = next[idx];
+  if (!r.reacted) {
+    next[idx] = { ...r, count: r.count + 1, reacted: true };
+  } else if (r.count <= 1) {
+    next.splice(idx, 1);
+  } else {
+    next[idx] = { ...r, count: r.count - 1, reacted: false };
+  }
+  return next;
+}
+
+/**
+ * Rebuild the stored `reactions` JSON (`{ emoji: userIds[] }`) from the local
+ * reaction list. We don't have the original user-id list locally, so the
+ * signed-in user is emitted when they are a reactor and the rest are padded
+ * with a synthetic marker to keep the count (best-effort until a backend
+ * reaction endpoint lands in M11).
+ */
+function toRemoteReactionShape(reactions: Reactions, userId: string): Record<string, string[]> {
+  const remoteShape: Record<string, string[]> = {};
+  for (const r of reactions) {
+    const ids: string[] = [];
+    if (r.reacted) ids.push(userId);
+    while (ids.length < r.count) ids.push('__other__');
+    remoteShape[r.emoji] = ids;
+  }
+  return remoteShape;
+}
