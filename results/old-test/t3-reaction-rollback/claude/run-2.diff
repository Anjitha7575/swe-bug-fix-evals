+/** Set whether the signed-in user has reacted with `emoji` on a comment. */
+function setOwnReaction(
+  current: FeedItem['reactions'],
+  { emoji, reacted }: { emoji: string; reacted: boolean },
+): FeedItem['reactions'] {
+  const idx = (current ?? []).findIndex(r => r.emoji === emoji);
+  const r = idx >= 0 ? current![idx] : undefined;
+  if (!!r?.reacted === reacted) return current;
+  const reactions = [...(current ?? [])];
+  if (!r) {
+    reactions.push({ emoji, count: 1, reacted: true });
+  } else if (reacted) {
+    reactions[idx] = { ...r, count: r.count + 1, reacted: true };
+  } else if (r.count <= 1) {
+    // Remove user's reaction
+    reactions.splice(idx, 1);
+  } else {
+    reactions[idx] = { ...r, count: r.count - 1, reacted: false };
+  }
+  return reactions;
+}
