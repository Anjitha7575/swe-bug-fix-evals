+type FeedReactions = NonNullable<FeedItem['reactions']>;
+
+/** One reaction click: the signed-in user's reaction to `emoji` should become `reacted`. */
+interface ReactionIntent {
+  emoji: string;
+  reacted: boolean;
+}
+
+/**
+ * `reactions` with the signed-in user's reaction to `intent.emoji` set to
+ * `intent.reacted`. Returns `reactions` itself (same reference) when it already
+ * says that, so a caller can tell a no-op from a change.
+ */
+function applyReactionIntent(reactions: FeedReactions, intent: ReactionIntent): FeedReactions {
+  const idx = reactions.findIndex(r => r.emoji === intent.emoji);
+  const current = idx >= 0 ? reactions[idx] : undefined;
+  if (!!current?.reacted === intent.reacted) return reactions;
+  const next = [...reactions];
+  if (intent.reacted) {
+    if (current) next[idx] = { ...current, count: current.count + 1, reacted: true };
+    else next.push({ emoji: intent.emoji, count: 1, reacted: true });
+  } else if (current!.count <= 1) {
+    next.splice(idx, 1);
+  } else {
+    next[idx] = { ...current!, count: current!.count - 1, reacted: false };
+  }
+  return next;
+}
+
+/**
+ * The `sys_comment.reactions` JSON for `reactions`: `{ emoji: userIds[] }`.
+ *
+ * We don't have the original user-id lists locally, so the signed-in user is
+ * emitted when they reacted and the rest of the count is padded with a
+ * synthetic `__other__` marker so it survives a re-read. This is an
+ * over-simplification for single-user pilot installs and will be replaced by a
+ * proper backend reaction endpoint in M11.
+ */
+function toStoredReactions(reactions: FeedReactions, userId: string): string {
+  const shape: Record<string, string[]> = {};
+  for (const r of reactions) {
+    const ids: string[] = [];
+    if (r.reacted) ids.push(userId);
+    while (ids.length < r.count) ids.push('__other__');
+    shape[r.emoji] = ids;
+  }
+  return JSON.stringify(shape);
+}
