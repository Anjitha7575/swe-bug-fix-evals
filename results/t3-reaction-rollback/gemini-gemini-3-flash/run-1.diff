+function computeToggledReactions(existing: Reaction[] | undefined, emoji: string): Reaction[] {
+  const reactions = [...(existing ?? [])];
+  const idx = reactions.findIndex(r => r.emoji === emoji);
+  if (idx >= 0) {
+    const r = reactions[idx];
+    if (r.reacted) {
+      if (r.count <= 1) {
+        reactions.splice(idx, 1);
+      } else {
+        reactions[idx] = { ...r, count: r.count - 1, reacted: false };
+      }
+    } else {
+      reactions[idx] = { ...r, count: r.count + 1, reacted: true };
+    }
+  } else {
+    reactions.push({ emoji, count: 1, reacted: true });
+  }
+  return reactions;
+}
+
+function reactionsEqual(a: Reaction[] | undefined, b: Reaction[] | undefined): boolean {
+  const listA = a ?? [];
+  const listB = b ?? [];
+  if (listA.length !== listB.length) return false;
+  for (const ra of listA) {
+    const rb = listB.find(r => r.emoji === ra.emoji);
+    if (!rb || rb.count !== ra.count || rb.reacted !== ra.reacted) return false;
+  }
+  return true;
+}
+
+function buildReactionRemoteShape(reactions: Reaction[], userId: string): Record<string, string[]> {
+  const remoteShape: Record<string, string[]> = {};
+  for (const r of reactions) {
+    const ids: string[] = [];
+    if (r.reacted) ids.push(userId);
+    while (ids.length < r.count) ids.push('__other__');
+    remoteShape[r.emoji] = ids;
+  }
+  return remoteShape;
+}
