 const EMPTY_FEED: FeedItem[] = [];
 
+type Reactions = NonNullable<FeedItem['reactions']>;
+
+/**
+ * Reaction state for one comment while its saves are in flight. `stored` is
+ * the last list the backend accepted. `intents` holds each emoji's latest
+ * click (the state the user asked for) and how many of its clicks are unsaved.
+ */
+interface ReactionWrites {
+  stored?: Reactions;
+  queue: Promise<void>;
+  intents: Map<string, { reacted: boolean; pending: number }>;
+}
+
+/**
+ * Sets whether the signed-in user has reacted with `emoji`. `count` stays
+ * "other reactors + the user", so the same call both adds and removes.
+ */
+function setReaction(reactions: Reactions | undefined, emoji: string, reacted: boolean): Reactions {
+  const list = reactions ?? [];
+  const existing = list.find(r => r.emoji === emoji);
+  const others = (existing?.count ?? 0) - (existing?.reacted ? 1 : 0);
+  const count = others + (reacted ? 1 : 0);
+  if (count <= 0) return list.filter(r => r.emoji !== emoji);
+  const entry = { emoji, count, reacted };
+  return existing ? list.map(r => (r.emoji === emoji ? entry : r)) : [...list, entry];
+}
+
+/**
+ * The `{ emoji: userIds[] }` shape `sys_comment.reactions` stores. Only the
+ * signed-in user's id is known here, so the other reactors are padded with a
+ * marker to keep the count across refreshes (best-effort; replaced by a
+ * proper backend reaction endpoint in M11).
+ */
+function toStoredReactions(reactions: Reactions, userId: string): Record<string, string[]> {
+  const stored: Record<string, string[]> = {};
+  for (const r of reactions) {
+    const ids = r.reacted ? [userId] : [];
+    while (ids.length < r.count) ids.push('__other__');
+    stored[r.emoji] = ids;
+  }
+  return stored;
+}
+
+/** What the panel shows: the stored reactions with each unsaved click laid over them. */
+function overlayReactions(
+  stored: Reactions | undefined,
+  intents: ReactionWrites['intents'],
+): Reactions | undefined {
+  let list = stored;
+  for (const [emoji, { reacted }] of intents) list = setReaction(list, emoji, reacted);
+  return list;
+}
