+/**
+ * Flip the signed-in user's `emoji` reaction in a comment's reaction list.
+ * Returns a new list; the input is not mutated.
+ */
+function toggleReaction(reactions: readonly Reaction[], emoji: string): Reaction[] {
+  const next = [...reactions];
+  const idx = next.findIndex(r => r.emoji === emoji);
+  if (idx < 0) {
+    next.push({ emoji, count: 1, reacted: true });
+  } else {
+    const r = next[idx];
+    if (!r.reacted) {
+      next[idx] = { ...r, count: r.count + 1, reacted: true };
+    } else if (r.count <= 1) {
+      next.splice(idx, 1);
+    } else {
+      next[idx] = { ...r, count: r.count - 1, reacted: false };
+    }
+  }
+  return next;
+}
+
+/**
+ * Rebuild the canonical `{ emoji: userIds[] }` shape the `sys_comment.reactions`
+ * JSON column stores. We don't keep the other reactors' ids locally, so the
+ * signed-in user is listed only when they reacted and the rest are padded with
+ * a synthetic marker so the count survives a refresh (best-effort until a
+ * backend reaction endpoint lands in M11).
+ */
+function toRemoteReactionShape(reactions: readonly Reaction[], userId: string): Record<string, string[]> {
+  const remoteShape: Record<string, string[]> = {};
+  for (const r of reactions) {
+    const ids: string[] = [];
+    if (r.reacted) ids.push(userId);
+    while (ids.length < r.count) ids.push('__other__');
+    remoteShape[r.emoji] = ids;
+  }
+  return remoteShape;
+}
