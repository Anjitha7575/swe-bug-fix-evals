 const EMPTY_FEED: FeedItem[] = [];
 
+/**
+ * Flip the signed-in user's `emoji` reaction. Returns a new array, so the
+ * previous list stays intact as the last stored state.
+ */
+function toggleReactionList(reactions: readonly Reaction[], emoji: string): Reaction[] {
+  const next = [...reactions];
+  const idx = next.findIndex(r => r.emoji === emoji);
+  if (idx < 0) {
+    next.push({ emoji, count: 1, reacted: true });
+  } else if (!next[idx].reacted) {
+    next[idx] = { ...next[idx], count: next[idx].count + 1, reacted: true };
+  } else if (next[idx].count <= 1) {
+    next.splice(idx, 1);
+  } else {
+    next[idx] = { ...next[idx], count: next[idx].count - 1, reacted: false };
+  }
+  return next;
+}
+
+/**
+ * Canonical `sys_comment.reactions` JSON shape (`{ emoji: userIds[] }`) rebuilt
+ * from the local reaction list. We don't have the other reactors' ids locally,
+ * so the signed-in user is emitted for their own reaction and a synthetic
+ * marker pads the rest so the count survives a refresh (best-effort, until a
+ * backend reaction endpoint lands in M11).
+ */
+function toRemoteReactions(reactions: readonly Reaction[], userId: string): Record<string, string[]> {
+  const remoteShape: Record<string, string[]> = {};
+  for (const r of reactions) {
+    const ids: string[] = [];
+    if (r.reacted) ids.push(userId);
+    while (ids.length < r.count) ids.push('__other__');
+    remoteShape[r.emoji] = ids;
+  }
+  return remoteShape;
+}
+
+/**
+ * Reaction saves for one comment. `stored` is the last value the backend
+ * confirmed; `desired` is what the UI shows after every click so far. Saves run
+ * one at a time, so the last one written is always the newest click.
+ */
+interface ReactionSave {
+  stored: Reaction[];
+  desired: Reaction[];
+  /** Bumped when a save fails; saves queued under an older value are dropped. */
+  generation: number;
+  /** Saves queued or in flight. */
+  pending: number;
+  tail: Promise<void>;
+}
