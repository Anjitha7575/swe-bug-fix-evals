+  reactions: NonNullable<FeedItem['reactions']>,
+  userId: string,
+): Record<string, string[]> {
+  const stored: Record<string, string[]> = {};
+  for (const r of reactions) {
+    const ids: string[] = r.reacted ? [userId] : [];
+    while (ids.length < r.count) ids.push('__other__');
+    stored[r.emoji] = ids;
+  }
+  return stored;
+}
