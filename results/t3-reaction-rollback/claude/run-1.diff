+/**
+ * One click on a reaction chip: the signed-in user's reaction on `emoji` is
+ * added when absent and removed when present. Pure — it never touches the input.
+ */
+function toggleReaction(
+  reactions: NonNullable<FeedItem['reactions']>,
+  emoji: string,
+): NonNullable<FeedItem['reactions']> {
+  const next = [...reactions];
+  const idx = next.findIndex(r => r.emoji === emoji);
+  if (idx < 0) {
+    next.push({ emoji, count: 1, reacted: true });
+  } else if (!next[idx].reacted) {
+    next[idx] = { ...next[idx], count: next[idx].count + 1, reacted: true };
+  } else if (next[idx].count <= 1) {
+    next.splice(idx, 1);
+  } else {
+    next[idx] = { ...next[idx], count: next[idx].count - 1, reacted: false };
+  }
+  return next;
+}
