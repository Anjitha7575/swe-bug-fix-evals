+type FeedReactions = FeedItem['reactions'];
+
+/** One comment's reaction writes: the stored reactions and the clicks not yet written. */
+interface ReactionQueue {
+  stored: FeedReactions;
+  pending: string[];
+  chain: Promise<void>;
+}
+
+/** The signed-in user's reaction `emoji` toggled on `reactions`. */
+function toggleReaction(reactions: FeedReactions, emoji: string): FeedReactions {
+  const next = [...(reactions ?? [])];
+  const idx = next.findIndex(r => r.emoji === emoji);
+  if (idx < 0) {
+    next.push({ emoji, count: 1, reacted: true });
+  } else if (!next[idx].reacted) {
+    next[idx] = { ...next[idx], count: next[idx].count + 1, reacted: true };
+  } else if (next[idx].count <= 1) {
+    next.splice(idx, 1);
+  } else {
+    next[idx] = { ...next[idx], count: next[idx].count - 1, reacted: false };
+  }
+  return next;
+}
+
+/**
+ * The `sys_comment.reactions` shape — `{ emoji: userIds[] }` — rebuilt from the
+ * aggregated local reactions. We don't have the original user-id list locally,
+ * so the signed-in user is emitted when they reacted and the rest of the count
+ * is padded with a synthetic marker so it survives a refresh. This is an
+ * over-simplification for single-user pilot installs and will be replaced by a
+ * proper backend reaction endpoint in M11.
+ */
+function reactionsToStored(reactions: FeedReactions, userId: string): Record<string, string[]> {
+  const stored: Record<string, string[]> = {};
+  for (const r of reactions ?? []) {
+    const ids: string[] = [];
+    if (r.reacted) ids.push(userId);
+    while (ids.length < r.count) ids.push('__other__');
+    stored[r.emoji] = ids;
+  }
+  return stored;
+}
