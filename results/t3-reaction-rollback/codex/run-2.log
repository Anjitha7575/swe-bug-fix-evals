          author_avatar_url: 'avatar' in currentUser ? (currentUser as any).avatar : undefined,
          body: text,
          mentions: JSON.stringify(mentionIds),
          created_at: newItem.createdAt,
          parent_id: parentId,
        });
      } catch (err) {
        throw commentWriteFailed(err);
