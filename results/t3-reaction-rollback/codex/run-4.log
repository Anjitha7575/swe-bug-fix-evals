    [currentUser, dataSource, objectName, pureRecordId, feedRecordKey, mentionSuggestions, commentWriteFailed],
  );

  const handleToggleReaction = useCallback(
    (itemId: string | number, emoji: string) => {
      if (!feedRecordKey) return;
      const writeKey = `${feedRecordKey}:${String(itemId)}`;
      // Reactions are toggled from the panel of the record on screen, so they
      // apply to that record's slice only (objectui#3268) — an id collision
      // with a row cached for another record cannot reach across.
      const before = feedItems.find(item => item.id === itemId);
      if (!before) return;
      const reactions = [...(before.reactions ?? [])];
          const idx = reactions.findIndex(r => r.emoji === emoji);
          if (idx >= 0) {
            const r = reactions[idx];
            if (r.reacted) {
              // Remove user's reaction
              if (r.count <= 1) {
                reactions.splice(idx, 1);
              } else {
                reactions[idx] = { ...r, count: r.count - 1, reacted: false };
              }
            } else {
              reactions[idx] = { ...r, count: r.count + 1, reacted: true };
            }
          } else {
            reactions.push({ emoji, count: 1, reacted: true });
          }
      const optimisticItem = { ...before, reactions };
      setFeedItemsByRecord(prev => ({
        ...prev,
        [feedRecordKey]: (prev[feedRecordKey] ?? EMPTY_FEED).map(item => item.id === itemId ? optimisticItem : item),
      }));
      if (!dataSource) return;
      const previous = reactionWrites.current.get(writeKey) ?? Promise.resolve();
      const write = previous.catch(() => {}).then(async () => {
        const reactions = optimisticItem!.reactions ?? [];
        const remoteShape: Record<string, string[]> = {};
        for (const r of reactions) {
          const ids = r.reacted ? [currentUser.id] : [];
          while (ids.length < r.count) ids.push('__other__');
          remoteShape[r.emoji] = ids;
        }
        try {
          await dataSource.update('sys_comment', String(itemId), { reactions: JSON.stringify(remoteShape) });
        } catch (err) {
          // Undo this click against the latest visible state, preserving any
          // later clicks that arrived while the request was pending.
          setFeedItemsByRecord(prev => ({
            ...prev,
            [feedRecordKey]: (prev[feedRecordKey] ?? EMPTY_FEED).map(item => {
              if (item.id !== itemId) return item;
              const current = [...(item.reactions ?? [])];
              const idx = current.findIndex(r => r.emoji === emoji);
              const wasReacted = before?.reactions?.find(r => r.emoji === emoji)?.reacted ?? false;
              if (idx >= 0) {
                const delta = wasReacted ? 1 : -1;
                const count = current[idx].count + delta;
                if (count <= 0) current.splice(idx, 1);
                else current[idx] = { ...current[idx], count, reacted: wasReacted };
              } else if (wasReacted) current.push({ emoji, count: 1, reacted: true });
              return { ...item, reactions: current };
            }),
          }));
          toast.error(err instanceof Error ? err.message : 'Could not save reaction');
        }
      });
      reactionWrites.current.set(writeKey, write);
      void write.finally(() => {
        if (reactionWrites.current.get(writeKey) === write) reactionWrites.current.delete(writeKey);
      });
    },
    [currentUser.id, dataSource, feedRecordKey, feedItems],
  );

  useEffect(() => {
    // Reset loading on navigation; the page-record effect above owns data fetching
    setIsLoading(true);
    queueMicrotask(() => setIsLoading(false));
  }, [objectName, recordId]);

  // Build the synthesized-page inputs — the object-derived parts that
